#class {lingwu} {open}
#if {$delay_duration && $delay_duration != ""} {#show 保持 delay_duration = $delay_duration } {#var delay_duration 0.2;#show 设置 delay_duration=0.2}
#action {^你领悟了一次%*。} {#delay $delay_duration {lingwu $sk_name 1}}
#action {^你现在过于疲倦,无法静下心来领悟功夫！$} {yun regenerate}
#action {^你略一凝神，精神看起来好多了。$} {lingwu $sk_name 1}
#action {你的内力已经枯竭，不能施用内功。} {sleep}
#action {你的内力不够。} {sleep}
#action {^你现在精不够，无法控制内息的流动！$} {#delay 5 {dazuo 300}}
#action {^你减缓真气运行，让自身恢复正常。$} {lingwu $sk_name 1}
#action {^你减缓真气运行，让气血运行恢复正常。$} {lingwu $sk_name 1}
#action {^你运功完毕，深深吸了口气，站了起来。$} {lingwu $sk_name 1}
#action {^你一觉醒来，精神抖擞地活动了几下手脚。$} {do 5 eat baozi;drink;lingwu $sk_name 1}
#action {^你的基本功夫比你的高级功夫还高！$} {#class {lingwu} {kill};s_lian $sk_name}
#class {lingwu} {close}

lingwu $sk_name 1
