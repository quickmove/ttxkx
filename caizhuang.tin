#class {caizhuang} {open}
#action {^你脚踩八卦方位，走得飞快。$} {
    #math {jing_val} {$my[jing]};
    #if {$jing_val>100} {#delay 1.5 {cai zhuang}} {#delay 1.5 {sleep}}
}
#action {^你一觉醒来，精神抖擞地活动了几下手脚。$} {dazuo 500}
#action {^你伸脚轻轻试了试木桩，心中有点发慌，忙缩了回来。$} {dazuo 500}
#action {^你运功完毕，深深吸了口气，站了起来。$} {#delay 1.5 {cai zhuang}}
#action {^你现在的气太少了，无法产生内息运行全身经脉。$} {sleep}
#action {^你现在精不够，无法控制内息的流动！$} {sleep}
#class {caizhuang} {close}

cai zhuang
