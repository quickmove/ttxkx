#event {CATCH SCREEN SPLIT FILL} {#nop}
#split 0 1
#read beautify.tin
beautify.On

#read hpbrief.tin

#action {^http://fullme.pkuxkx.net/robot.php?filename=%*} {#system {fullme %0}}

#alias s_dazuo {#read dazuo.tin}
#alias e_dazuo {#class {dazuo} {kill}}

#alias s_tuna {#read tuna.tin}
#alias e_tuna {#class {tuna} {kill}}

#alias yz_hq {enter shudong;say 天堂有路你不走;d;2;ne;ne;u;enter;e}
#alias hq_yz {w;out;enter dong;sw;sw;sw;u;out}
#alias s_xue {#var sk_name %1;#var teacher %2;#read xue.tin}
#alias e_xue {#class {xue} {kill};#unvar sk_name;#unvar teacher}
#alias s_lian {#var sk_name %1;#read lian.tin}
#alias e_lian {#class {lian} {kill};#unvar sk_name}
#alias s_du {#var book_name %0;#read du.tin}
#alias e_du {#class {du} {kill};#unvar book_name}
#alias s_lw {#var sk_name %1;#read lingwu.tin}
#alias e_lw {#class {lingwu} {kill};#unvar sk_name}
#alias dtime {#var delay_duration %1}

#alias sms node walk sjy_sms
#alias sjob {#read caojing.tin}
#alias rp {ask sengren about done;report %0}

#alias hhjd {say 红花老祖本姓朱，为救苍生下凡来}
#alias wk walk
#alias pa_yinggu {s; e; n; w; s; s; w}
#alias {pa_mrch} {w;n;w;s;s;e;e;w;w}
#alias {pa_mrch_out} {e;s;n;w;n;n;e;s;e}
#alias {gt} {node walk %0}

#alias ddr {#var delay_duration %0;#show 设置delay_duration=$delay_duration}
#alias rr {yun recover}
#alias gc {get silver from corpse;get gold from corpse;get xin from corpse}
#alias gx {give xin to pu}

#session xkx mud.pkuxkx.net 8081
